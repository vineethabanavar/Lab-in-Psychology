        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Welcome to the experiment.&amp;#10;&amp;#10;You will see a series of photographs, one at a time. Your task is to rate how emotionally intense each picture feels to you.&amp;#10;&amp;#10;Use the number keys from 1 to 4: &amp;#10;1 = not emotionally intense at all&amp;#10;4 = extremely emotionally intense&amp;#10;&amp;#10;There are no right or wrong answers — please respond based on your immediate feeling. &amp;#10;&amp;#10;&amp;#10;Press SPACE to begin." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="key_resp" plugin="None">
        <Param val="'space'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
